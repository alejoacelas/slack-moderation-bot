[Unit]
Description=Moderation Bot for the AI Uplift Slack
After=network-online.target

[Service]
WorkingDirectory=%h/work/slack-moderation-bot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/op-agent run --env-file %h/work/slack-moderation-bot/deploy/alejo/server.env.tpl -- %h/.local/bin/uv run --frozen python -m modbot.bot
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
